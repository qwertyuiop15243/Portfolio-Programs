    factor = 128
    for x in range(width):
        for y in range(height):
            
            # Get current RGB
            r, g, b = pixel_map[x, y]
            # Modify the RGB values here
            r = (r // factor) * factor
            g = (g // factor) * factor
            b = (b // factor) * factor
            
            # Save them back to the map
            pixel_map[x, y] = (r, g, b) 
