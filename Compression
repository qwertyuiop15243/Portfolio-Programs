from PIL import Image
import os

# ==========================================
# PART 1: LOSSLESS COMPRESSION (RLE)
# ==========================================
def compress_lossless(image_path):
    print("--- Starting Lossless Compression ---")
    img = Image.open(image_path).convert('RGB')
    
    # getdata() flattens the image into a 1D list of (R,G,B) tuples
    pixels = list(img.getdata()) 
    print(pixels)
    compressed_data = []
    
    # ---------------------------------------------------------
    # TODO 1: Implement Run-Length Encoding (RLE)
    # 1. Create variables to track the 'current_color' and 'count'.
    # 2. Loop through every pixel in the 'pixels' list.
    # 3. If the pixel matches the 'current_color', increase the count.
    # 4. If it's different, append (current_color, count) to 'compressed_data',
    #    then reset the color and count for the new pixel.
    # ---------------------------------------------------------
    # ---------------------------------------------------------
    # TODO 1: Implement Run-Length Encoding (RLE)
    # ---------------------------------------------------------
    current_color = pixels[0]
    count = 0
    for pixel in pixels:
        if pixel == current_color:
            count += 1
        else:
            compressed_data.append((current_color, count))
            current_color = pixel
            count = 1


    # >>> END YOUR CODE <<<
    
    # Let's calculate how much space we theoretically saved!
    # A standard RGB pixel is 3 bytes (1 byte each for Red, Green, Blue).
    original_bytes = len(pixels) * 3 
    
    # Our compressed list stores a color (3 bytes) + a count number (approx 1 byte) = 4 bytes per run
    compressed_bytes = len(compressed_data) * 4 
    
    print(f"Original Image Size: {original_bytes} bytes")
    print(f"Compressed Data Size: {compressed_bytes} bytes")
    
    if compressed_bytes < original_bytes:
        print("Success! You saved space without losing a single pixel of data.")
    else:
        print("Your size increased! Why might RLE be bad for highly detailed photographs?")


