def get_task_input():


    task = input("Enter a task: ")
    return task if task else None




def save_task(task):
    try:
        with open("tasks.txt", "a") as file:
            file.write(task + "\n")
        print(f"Task added.")
    except IOError as e:
        print(f"Error writing to file: {e}")




def add_tasks():
    while True:
        task = get_task_input()
        if task is None:
            break
        save_task(task)


add_tasks()

